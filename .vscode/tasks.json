{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Lithair: Build Debug",
      "type": "shell",
      "command": "task",
      "args": [
        "build"
      ],
      "group": "build",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "Lithair: Build Release",
      "type": "shell",
      "command": "task",
      "args": [
        "build:release"
      ],
      "group": "build",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "Lithair: Build Workspace (CI)",
      "type": "shell",
      "command": "cidx",
      "args": [
        "run",
        "build"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "Lithair: Format",
      "type": "shell",
      "command": "task",
      "args": [
        "fmt"
      ],
      "group": "build",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "Lithair: Code Check",
      "type": "shell",
      "command": "cidx",
      "args": [
        "run",
        "code"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Lithair: Test Gate",
      "type": "shell",
      "command": "cidx",
      "args": [
        "run",
        "test"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "Lithair: CI PR",
      "type": "shell",
      "command": "cidx",
      "args": [
        "run",
        "pr"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "Lithair: CI Full",
      "type": "shell",
      "command": "cidx",
      "args": [
        "run",
        "ci"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "Lithair: PR Status",
      "type": "shell",
      "command": "cidx",
      "args": [
        "repo",
        "pr",
        "status"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "Lithair: Start Hello World (Debug)",
      "type": "shell",
      "command": "task",
      "args": [
        "examples:hello-world"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "rust",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(\\d+):\\s+(\\d+)\\s+(warning|error):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 6,
          "message": 7
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Compiling.*$",
          "endsPattern": "^.*Finished.*$"
        }
      }
    },
    {
      "label": "Lithair: Start Hello World (Release)",
      "type": "shell",
      "command": "task",
      "args": [
        "examples:hello-world:release"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "isBackground": true
    },
    {
      "label": "Lithair: HTTP Firewall Demo",
      "type": "shell",
      "command": "task",
      "args": [
        "examples:replication:firewall"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Lithair: Benchmark JSON Small",
      "type": "shell",
      "command": "task",
      "args": [
        "bench:json-small"
      ],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Lithair: Benchmark JSON Large",
      "type": "shell",
      "command": "task",
      "args": [
        "bench:json-large"
      ],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Lithair: Benchmark Host Router",
      "type": "shell",
      "command": "task",
      "args": [
        "bench:host-router"
      ],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Lithair: Clean",
      "type": "shell",
      "command": "task",
      "args": [
        "clean"
      ],
      "group": "build",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    },
    {
      "label": "Lithair: Show Docs",
      "type": "shell",
      "command": "task",
      "args": [
        "docs"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Lithair: Show Help",
      "type": "shell",
      "command": "task",
      "args": [
        "help"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
